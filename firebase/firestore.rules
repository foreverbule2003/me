rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 站主本人（Google 登入的 Firebase UID）。GitHub Actions 用 service account 寫入，不受這份規則限制
    function isOwner() {
      return request.auth != null && request.auth.uid == 'mmAs3PqbA8aQgKzi3PH7VxrUrnH3';
    }

    // 旅遊頁的共享勾選：任何人可寫，但只收前端實際寫的欄位
    // 有共享勾選的旅程白名單；tools/new-trip.js 建新旅程時會自動加進來，加完要重新部署規則
    function isKnownTrip(tripId) {
      return tripId in [
        '2024-kyoto',
        '2024-tokyo-disney',
        '2026-ise-shima',
        '2026-okinawa',
        '2026-tokyo'
      ];
    }
    function isTripKind(kind) {
      return kind in ['food_ratings', 'shopping_purchased', 'todo_completed'];
    }
    // 前端 getItemKey／getShoppingItemKey／getWishlistItemKey 產生的格式（todo- 是 ise-shima 的舊資料）
    function isTripItemId(itemId) {
      return itemId.matches('^(food-[0-9]{1,3}-[0-9]{1,3}-[0-9]{1,3}|shopping-[0-9]{1,3}-[0-9]{1,3}|wishlist-[0-9]{1,3}|todo-[0-9]{1,3})$');
    }
    function isShortString(v) {
      return v is string && v.size() <= 64;
    }
    function isTripMark() {
      return request.resource.data.keys().hasOnly(['timestamp', 'userId'])
        && isShortString(request.resource.data.timestamp)
        && (!('userId' in request.resource.data) || isShortString(request.resource.data.userId));
    }

    match /trips/{tripId}/{kind}/{itemId} {
      allow read: if isKnownTrip(tripId) && isTripKind(kind);
      allow create, update: if isKnownTrip(tripId) && isTripKind(kind)
        && isTripItemId(itemId) && isTripMark();
      allow delete: if isKnownTrip(tripId) && isTripKind(kind) && isTripItemId(itemId);
    }

    // 日記：公開瀏覽，只有站主能寫
    match /journal_entries/{entryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // CB 資料：公開讀；前端只有站主（我的追蹤、手動改轉換價）能寫
    match /cb_history/{symbol} {
      allow read: if true;
      allow write: if isOwner();

      match /records/{date} {
        allow read: if true;
        allow write: if isOwner();
      }
    }

    match /hot_cb_meta/{docId} {
      allow read: if true;
    }
    match /hot_cb_snapshots/{docId} {
      allow read: if true;
    }

    // 前端已不寫 log，關掉公開寫入
    match /system_logs/{logId} {
      allow read: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
