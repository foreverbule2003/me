# Dependencies
node_modules/

# OS Files
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
.idea/
.vscode/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/

# Logs
*.log
npm-debug.log*
build_log*.txt

# Build outputs
dist/
build/

# Local env files
.env
.env.local

# Temp files
*.tmp
*.temp

# AI-generated reports (regeneratable via /review workflow)
ARCHITECTURAL_REVIEW.md

# Firebase Admin Keys (NEVER commit these)
*serviceAccountKey*.json
service-account.json

# Dynamic Data (Synced to Firestore, not for Git)
public/data/history/
public/data/hot-cb.json
public/data/cb-data.json
public/data/cb-data.json.bak
.hot-cb-cache.json

# Tool Data & Logs
tools/*.json
!tools/package.json
# Test artifacts
test-results/
playwright-report/
blob-report/
.vitest-result/
logs/

# Claude Code local settings (per-machine permission cache)
.claude/settings.local.json

# Archify 圖表產物（skill 安裝於 ~/.claude/skills/archify，本體不在 repo）
# 只有規格 JSON 進版控（docs/diagrams/*.architecture.json）；
# 渲染出的 HTML 與 visual-check 截圖屬可再生產物，一律忽略。
# 重生指令：node ~/.claude/skills/archify/bin/archify.mjs deliver architecture \
#   docs/diagrams/<name>.architecture.json docs/diagrams/<name>.html \
#   --quality showcase --repo-root .
.archify/
*.archify.json
*.archify.html
docs/diagrams/*.html
docs/diagrams/*.png

# 離線旅遊小書：npm run build 時由 data.js 產生並直接輸出到 dist（vite.config.js 的 trip-offline-book plugin），
# 本機 node scripts/generate-travel-pdf.mjs {trip} 的產物只供預覽／轉 PDF
trips/*/master_guide.html

# 旅行社原始行程表（含業務聯絡個資，不進公開 repo；內容已整理進各旅程的 spec.md 與 trip_notes.md）
trips/*/source_*.pdf
