{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/tools/guard/check-remote-sync.mjs\"",
            "timeout": 40,
            "statusMessage": "檢查遠端同步…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/check-ai-coinage.mjs\"",
            "timeout": 10,
            "statusMessage": "掃 AI 自造詞…"
          }
        ]
      }
    ]
  }
}
